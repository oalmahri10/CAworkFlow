DATABASE_URL="file:./dev.db"
# Generate a strong random value for real use, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32-byte-hex-string"
DOCUMENTS_ROOT="./var/documents"

# Optional future email provider. The application runs fully without these.
# Leave blank to keep in-app-only notifications and an explicit
# "Email not configured" state — the app never simulates a sent email.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
