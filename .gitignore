# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# BisB Credit Command: local database, documents and test artifacts.
# These are generated locally and must never be committed — the app must
# always start from an empty database, per the product requirements.
/prisma/dev.db
/prisma/dev.db-journal
/prisma/test.db
/prisma/test.db-journal
/var/documents/
/var/test-documents/
!/var/documents/.gitkeep
!/var/test-documents/.gitkeep
